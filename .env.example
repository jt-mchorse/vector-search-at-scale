# Copy to .env (gitignored) and fill in only the backends you run. Nothing
# loads it automatically:
#   set -a; . ./.env; set +a
# The `stub` backend, the HNSW simulation and the whole test suite need none.

# --backend pgvector   (pip install -e '.[pgvector]'); a libpq connection string.
PGVECTOR_DSN=postgresql://user:password@localhost:5432/vectors

# --backend qdrant     (pip install -e '.[qdrant]'); the HTTP URL.
QDRANT_URL=http://localhost:6333

# --backend weaviate   (pip install -e '.[weaviate]'); a bare host name, no
# scheme or port. It is passed as both the HTTP and the gRPC host.
WEAVIATE_HOST=localhost
